@{
    ViewData["Title"] = "Tebrikler";
}

<div class="container mt-5" style="max-width: 550px;">
    <div class="card shadow-lg p-5 text-center bg-white" style="border-radius: 20px; border: none;">

        <div class="mb-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem; filter: drop-shadow(0px 4px 8px rgba(40, 167, 69, 0.3));"></i>
        </div>

        <h2 class="fw-bold text-dark mb-3">Talebiniz Alındı!</h2>

        <p class="text-muted mb-4 lead fs-6">
            Kiralama talebiniz ürün sahibine başarıyla iletilmiştir. Girmiş olduğunuz telefon numarası üzerinden sizinle en kısa sürede iletişime geçilecektir.
        </p>

        <hr class="my-4 text-muted" style="opacity: 0.15;">

        <a asp-controller="Home" asp-action="Index" class="btn btn-success w-100 py-2 fw-bold rounded-pill shadow-sm">
            <i class="bi bi-house-door-fill me-1"></i> Ana Sayfaya Dön
        </a>

    </div>
</div>
