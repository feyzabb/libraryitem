
@{
    ViewData["Title"] = "Üye Ol";
}
@if (ViewBag.HataMesaji != null)
{
    <div class="alert alert-danger text-center small py-2">
        @ViewBag.HataMesaji
    </div>
}
<link rel="stylesheet" href="~/css/site.css" />
<div class="register-form-internal">
    <form asp-controller="Account" asp-action="Register" method="post">
        <div class="form-group mb-3 text-start">
            <label class="fw-bold small">Ad Soyad / Kullanıcı Adı</label>
            <input type="text" name="Username" class="form-control rounded-pill bg-light" placeholder="Adınızı girin" required />
        </div>

        <div class="form-group mb-3 text-start">
            <label class="fw-bold small">E-posta</label>
            <input type="email" name="Email" class="form-control rounded-pill bg-light" placeholder="E-posta adresinizi girin" required />
        </div>

        <div class="form-group mb-4 text-start">
            <label class="fw-bold small">Şifre</label>
            <input type="password" name="Password" class="form-control rounded-pill bg-light" placeholder="Şifrenizi girin" required />
        </div>

        <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm">Üye Ol</button>
    </form>
</div>

