@{
    Layout = null;
}

<div class="register-form-internal">
    <form asp-controller="Account" asp-action="Register" method="post">
        <div class="form-group mb-3 text-start">
            <label class="fw-bold small">Ad Soyad</label>
            <input type="text" name="FullName" class="form-control rounded-pill bg-light" placeholder="Adınızı girin" required />
        </div>


        <div class="form-group mb-4 text-start">
            <label class="fw-bold small">Şifre</label>
            <input type="password" name="Password" class="form-control rounded-pill bg-light" placeholder="Şifrenizi girin" required />
        </div>

        <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm">Giriş Yap</button>
    </form>
</div>
<div class="register-link mt-3 text-center">
    <p>
        Üye değilseniz
        <a href="#" data-bs-toggle="modal" data-bs-target="#registerModal" data-bs-dismiss="modal">Üye Ol</a>
    </p>
</div>