@model Library_Item.Models.Item

@{
    ViewData["Title"] = "Yeni İlan Ekle";
}

<div class="container mt-5">
    <div class="card shadow mx-auto p-4" style="max-width: 600px; border-radius: 15px; border: none;">
        <h3 class="fw-bold text-center text-dark mb-4">
            <i class="bi bi-plus-circle-fill text-success me-2"></i>Kiralık İlanı Ekle
        </h3>
        <p class="text-muted text-center small mb-4">Kiraya vermek istediğiniz ürünün bilgilerini giriniz.</p>

        <form asp-controller="Account" asp-action="AddItem" method="post" enctype="multipart/form-data">

            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">İlan Başlığı</label>
                <input type="text" name="Title" class="form-control" placeholder="Örn: Oyuncu Bilgisayarı i7 / 16GB RAM" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Kategori</label>
                <select name="Category" class="form-select" required>
                    <option value="Elektronik">Elektronik</option>
                    <option value="Sanat">Sanat</option>
                    <option value="Bahce">Bahçe</option>
                    <option value="Ev">Ev</option>
                    <option value="Diğer">Diğer</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Günlük Kiralama Ücreti (₺)</label>
                <input type="number" name="Price" class="form-control" placeholder="Örn: 150" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Ürün Görseli</label>
                <input type="file" name="ImageFile" id="imageFileInput" class="form-control" accept="image/*" />
                <span class="text-muted" style="font-size: 0.75rem;">Bilgisayarınızdan veya telefonunuzdan bir fotoğraf seçin.</span>
                
                <!-- Görsel Önizleme Alanı -->
                <div id="imagePreviewContainer" class="mt-3 text-center" style="display: none;">
                    <img id="imagePreview" src="#" alt="Görsel Önizleme" 
                         style="max-width: 100%; max-height: 250px; border-radius: 10px; border: 2px solid #e2e8f0; object-fit: cover;" />
                    <p class="text-muted small mt-1"><i class="bi bi-check-circle-fill text-success me-1"></i>Görsel seçildi</p>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-secondary">Ürün Açıklaması</label>
                <textarea name="Description" class="form-control" rows="4" placeholder="Ürünün özelliklerini, teslimat şartlarını buraya yazın..." required></textarea>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 rounded-pill fw-bold shadow-sm">
                <i class="bi bi-cloud-arrow-up-fill me-1"></i> İlanı Paylaş
            </button>

        </form>
    </div>
</div>

<!-- Seçilen görselin önizlemesini gösteren JavaScript -->
<script>
    document.getElementById('imageFileInput').addEventListener('change', function (event) {
        var file = event.target.files[0];
        var previewContainer = document.getElementById('imagePreviewContainer');
        var previewImage = document.getElementById('imagePreview');

        if (file) {
            var reader = new FileReader();
            reader.onload = function (e) {
                previewImage.src = e.target.result;
                previewContainer.style.display = 'block';
            }
            reader.readAsDataURL(file);
        } else {
            previewContainer.style.display = 'none';
        }
    });
</script>