@model IEnumerable<Library_Item.Models.Item>

@{
    ViewData["Title"] = "İlanlarım";
}

<div class="container mt-5">
    <div class="card shadow-sm p-4" style="border-radius: 15px; border: none; min-height: 400px;">

        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div class="d-flex align-items-center gap-2">
                <h3 class="fw-bold text-dark m-0">
                    <i class="bi bi-collection-fill text-warning me-2"></i>Kirala Bunu - İlanlarım
                </h3>
                <span class="badge bg-secondary">@Model.Count() İlan</span>
            </div>

            <a asp-controller="Account" asp-action="AddItem" class="btn btn-success rounded-pill px-4 shadow-sm fw-bold">
                <i class="bi bi-plus-lg me-1"></i> Ürün Kiraya Ver
            </a>
        </div>

        <hr />

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 100px;">Görsel</th>
                            <th>İlan Başlığı</th>
                            <th>Kategori</th>
                            <th>Günlük Fiyat</th>
                            <th class="text-center" style="width: 200px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ilan in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@ilan.ImageUrl" alt="@ilan.Title" class="rounded" style="width: 60px; height: 60px; object-fit: cover;" />
                                </td>
                                <td>
                                    <h6 class="fw-bold m-0 text-dark">@ilan.Title</h6>
                                </td>
                                <td><span class="badge bg-light text-dark border">@ilan.Category</span></td>
                                <td class="fw-bold text-success">@ilan.Price ₺</td>
                                <td>
                                    <div class="d-flex gap-2 justify-content-center">
                                        <a asp-controller="Account" asp-action="Edit" asp-route-id="@ilan.Id" class="btn btn-sm btn-warning text-white rounded-pill px-3">
                                            <i class="bi bi-pencil-square"></i> Düzenle
                                        </a>
                                        <form asp-controller="Account" asp-action="Delete" asp-route-id="@ilan.Id" method="post" onsubmit="return confirm('Bu ilanı tamamen silmek istediğinize emin misiniz?');" class="m-0">
                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3">
                                                <i class="bi bi-trash-fill"></i> Sil
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 my-auto">
                <i class="bi bi-folder-x text-muted" style="font-size: 4rem;"></i>
                <p class="text-muted mt-3 fs-5">Henüz sisteme eklediğiniz bir kiralık ilan bulunmuyor.</p>
                <p class="text-muted small">Yukarıdaki <b>"Ürün Kiraya Ver"</b> butonunu kullanarak ilk bilgisayarını veya ilanını hemen ekleyebilirsin!</p>
            </div>
        }
    </div>
</div>