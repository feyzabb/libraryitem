@{
    ViewData["Title"] = "Yeni İlan Ekle";
}
<div class="container mt-5">
    <h1>Yeni İlan Ekle</h1>
    <p>Kiraya vermek istediğiniz ürünün bilgilerini giriniz</p>

    <form asp-action="Create" method="post" enctype="multipart/form-data">

        <div class="form-group">
            <div class="mb-3">
                <label>Ürün Adı</label>
                <input type="text" name="Title" class="form-control" placeholder="Ürün İsmi" required />
            </div>

            <div class="mb-3">
                <label>Açıklama</label>
                <input type="text" name="Description" class="form-control" placeholder="Ürün açıklaması" />
            </div>

            <div class="mb-3">
                <label>Kategori</label>
                <select name="Category" class="form-control">
                    <option value="Ev Eşyası">Ev Eşyası</option>
                    <option value="Elektronik">Elektronik</option>
                    <option value="Bahçe">Bahçe</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Günlük Ücret</label>
                <input type="number" name="Price" class="form-control" placeholder="Günlük Ücret" required />
            </div>

            <div class="mb-3">
                <label class="fw-bold small mb-1 text-muted">Ürün Fotoğrafı Seç</label>
                <input type="file" name="ImageFile" class="form-control" accept="image/*" required />
            </div>

            <button type="submit" class="btn btn-success">İlanı Yayınla</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Geri Dön</a>
        </div>

    </form>
</div>
		








