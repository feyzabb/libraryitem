@model IEnumerable<Library_Item.Models.Item>
<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

@if (TempData["LoginHata"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show text-center fw-bold mx-3 mt-2 shadow-sm" role="alert" style="border-radius: 12px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["LoginHata"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="bg-transparent border-0 mb-4">
    <div class="container">
        <ul class="nav category-nav d-flex justify-content-center flex-wrap gap-2 py-2">
            <li class="nav-item">
                <a class="nav-link @(string.IsNullOrEmpty(ViewBag.SelectedCategory) ? "active" : "")"
                   asp-controller="Home" asp-action="Index">Tüm Kategoriler</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewBag.SelectedCategory == "Sanat" ? "active" : "")"
                   asp-controller="Home" asp-action="Index" asp-route-category="Sanat">Sanat</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewBag.SelectedCategory == "Elektronik" ? "active" : "")"
                   asp-controller="Home" asp-action="Index" asp-route-category="Elektronik">Elektronik</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewBag.SelectedCategory == "Ev" ? "active" : "")"
                   asp-controller="Home" asp-action="Index" asp-route-category="Ev">Ev Eşyası</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewBag.SelectedCategory == "Bahce" ? "active" : "")"
                   asp-controller="Home" asp-action="Index" asp-route-category="Bahce">Bahçe</a>
            </li>
        </ul>
    </div>
</div>

<section class="hero-section text-center py-5" style="background: #ffffff;">
    <div class="container">
        <h1 class="display-4 mb-3">KiralaBunu'ya Hoş Geldiniz!</h1>
        <p class="lead mb-4">Eşyalarınızı paylaşarak kazanın, ihtiyacınız olanı kiralayarak tasarruf edin.</p>

        <form asp-controller="Home" asp-action="Index" method="get" class="search-bar mx-auto" style="max-width: 700px">
            <div class="input-group shadow-sm">
                <input type="text" name="searchString" class="form-control" placeholder="İlan, Kategori, Konum ara..." value="@ViewData["CurrentFilter"]" />
                <button type="submit" class="btn btn-primary px-4">Ara</button>
            </div>
        </form>
    </div>
</section>
<div class="py-5 my-4 rounded-4 shadow-sm" style="background: #ffffff; border: 1px solid #f1f5f9;">
    <div class="container text-center">
        <h4 class="fw-bold mb-4" style="color: var(--dark);">KiralaBunu Nasıl Çalışır?</h4>
        <div class="row">
            <div class="col-md-4 mb-3">
                <div class="p-4 rounded-3 h-100 border-0" style="background: #f8fafc; border: 1px solid #e2e8f0 !important;">
                    <i class="bi bi-search fs-2" style="color: var(--primary);"></i>
                    <h6 class="fw-bold mt-3" style="color: var(--dark);">1. İhtiyacını Bul</h6>
                    <p class="text-muted small mb-0">Binlerce ürün arasından sana en yakın olanı seç.</p>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="p-4 rounded-3 h-100 border-0" style="background: #f8fafc; border: 1px solid #e2e8f0 !important;">
                    <i class="bi bi-calendar-check fs-2" style="color: var(--primary);"></i>
                    <h6 class="fw-bold mt-3" style="color: var(--dark);">2. Sahibiyle Anlaş</h6>
                    <p class="text-muted small mb-0">Formu doldur, ilan sahibiyle hemen iletişime geç.</p>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="p-4 rounded-3 h-100 border-0" style="background: #f8fafc; border: 1px solid #e2e8f0 !important;">
                    <i class="bi bi-wallet2 fs-2" style="color: var(--primary);"></i>
                    <h6 class="fw-bold mt-3" style="color: var(--dark);">3. Tasarruf Et &amp; Kazan</h6>
                    <p class="text-muted small mb-0">Satın almak yerine kirala, paranı cebinde tut!</p>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="categories-segments my-4">
</div>


<div class="container my-5">
    <div class="row">
        <div class="col-md-3">
            <div class="card mb-3 shadow-sm border-0 p-3 bg-white">
                <h6 class="fw-bold mb-3">Kategoriler</h6>

                <div class="list-group list-group-flush mb-4">
                    <a asp-controller="Home" asp-action="Index"
                       class="list-group-item list-group-item-action border-0 rounded-3 mb-1 @(string.IsNullOrEmpty(ViewBag.SelectedCategory) ? "bg-success text-white fw-bold" : "")">
                        Tüm Kategoriler
                    </a>

                    <a asp-controller="Home" asp-action="Index" asp-route-category="Sanat"
                       class="list-group-item list-group-item-action border-0 rounded-3 mb-1 @(ViewBag.SelectedCategory == "Sanat" ? "bg-success text-white fw-bold" : "")">
                        Sanat
                    </a>

                    <a asp-controller="Home" asp-action="Index" asp-route-category="Elektronik"
                       class="list-group-item list-group-item-action border-0 rounded-3 mb-1 @(ViewBag.SelectedCategory == "Elektronik" ? "bg-success text-white fw-bold" : "")">
                        Elektronik
                    </a>

                    <a asp-controller="Home" asp-action="Index" asp-route-category="Ev"
                       class="list-group-item list-group-item-action border-0 rounded-3 mb-1 @(ViewBag.SelectedCategory == "Ev" ? "bg-success text-white fw-bold" : "")">
                        Ev Eşyası
                    </a>

                    <a asp-controller="Home" asp-action="Index" asp-route-category="Bahce"
                       class="list-group-item list-group-item-action border-0 rounded-3 mb-1 @(ViewBag.SelectedCategory == "Bahce" ? "bg-success text-white fw-bold" : "")">
                        Bahçe
                    </a>
                </div>

                <h6 class="fw-bold mb-3">Konum Seç</h6>
                <select class="form-select bg-light">
                    <option>Tüm Konumlar</option>
                    <option>İstanbul</option>
                    <option>Ankara</option>
                    <option>İzmir</option>
                </select>
            </div>
        </div>

        <div class="col-md-9">
            <h3 class="mb-4 fw-bold">Son Eklenen İlanlar</h3>
            <div class="row">

                @foreach (var ilan in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm h-100">
                            @if (!string.IsNullOrEmpty(ilan.ImageUrl))
                            {
                                <img src="@ilan.ImageUrl" class="card-img-top" alt="@ilan.Title" style="height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <img src="https://images.unsplash.com/photo-1531403009284-440f080d1e12?w=500&auto=format&fit=crop" class="card-img-top" alt="Ürün" style="height: 200px; object-fit: cover;">
                            }

                            <div class="card-body text-center">
                                <h5 class="card-title fw-bold">@ilan.Title</h5>
                                <p class="card-text price-text fw-bold text-success">@ilan.Price ₺ / Günlük</p>
                                <a asp-controller="Items" asp-action="Details" asp-route-id="@ilan.Id" class="btn btn-outline-primary btn-sm w-100">Detayları Gör</a>
                            </div>
                        </div>
                    </div>
                }


            </div>
        </div>
    </div>
</div>
