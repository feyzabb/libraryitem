@{
    ViewData["Title"] = "Ana Sayfa";
}

<link rel="stylesheet" href="~/css/site.css" />

<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom stick-top">

    <div class="container">

        <a class="navbar-brand fw-bold text-primary fs-3" href="Home/Item">
            Library Item
        </a>

        <div class="d-flex align-items-center gap-3">

            <a class="nav-link" href="/Account/Basket">

                <img src="https://static.vecteezy.com/system/resources/previews/010/576/702/original/basket-icon-logo-illustration-shopping-basket-symbol-template-for-graphic-and-web-design-collection-free-vector.jpg"
                     alt="Kirala"
                     style="width: 45px; height: 45px;">

            </a>

            <button class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-camera-fill me-1"></i>
                Kirala
            </button>

        </div>

    </div>

</nav>

<div class="bg-white border-bottom shadow-sm">

    <div class="container">

        <ul class="nav category-nav d-flex justify-content-between py-2">

            <li class="nav-item">
                <button class="nav-link active">
                    Tüm Kategoriler
                </button>
            </li>

            <li class="nav-item">
                <button class="nav-link">
                    Sanat
                </button>
            </li>

            <li class="nav-item">
                <button class="nav-link">
                    Elektronik
                </button>
            </li>

            <li class="nav-item">
                <button class="nav-link">
                    Ev Eşyası
                </button>
            </li>

            <li class="nav-item">
                <button class="nav-link">
                    Bahçe
                </button>
            </li>

        </ul>

    </div>

</div>

<section class="hero-section text-center py-5 bg-light">

    <div class="container">

        <h1 class="display-4 mb-3">
            Library Item'e Hoş Geldiniz!
        </h1>

        <p class="lead mb-4">
            Eşyalarınızı paylaşarak kazanın, ihtiyacınız olanı kiralayarak tasarruf edin.
        </p>

        <div class="search-bar mx-auto" style="max-width: 700px">

            <div class="input-group shadow-sm">

                <input type="text"
                       class="form-control"
                       placeholder="İlan, Kategori, Konum ara..." />

                <button type="button"
                        class="btn btn-primary px-4">

                    Ara

                </button>

            </div>

        </div>

    </div>

</section>

<div class="container my-5">

    <div class="row">

        <!-- SIDEBAR -->

        <div class="col-md-3">

            <div class="card mb-3 shadow-sm border-0 p-3 bg-white">

                <h6 class="fw-bold mb-3">
                    Kategoriler
                </h6>

                <select class="form-select bg-light mb-3">

                    <option>Tüm Kategoriler</option>
                    <option>Sanat</option>
                    <option>Elektronik</option>
                    <option>Ev Eşyası</option>
                    <option>Bahçe</option>
                    <option>Moda</option>

                </select>

                <h6 class="fw-bold mb-3">
                    Konum Seç
                </h6>

                <select class="form-select bg-light">

                    <option>Tüm Konumlar</option>
                    <option>İstanbul</option>
                    <option>Ankara</option>
                    <option>İzmir</option>

                </select>

            </div>

        </div>

        <!-- URUNLER -->

        <div class="col-md-9">

            <h3 class="mb-4 fw-bold">
                Son Eklenen İlanlar
            </h3>

            <div class="row">

                <!-- KEMAN -->

                <div class="col-md-4 mb-4">

                    <div class="card shadow-sm h-100">

                        <img src="https://tse4.mm.bing.net/th/id/OIP.k-43T6LNjZTHbEMe1XYT_gHaE1?r=0&rs=1&pid=ImgDetMain&o=7&rm=3"
                             class="card-img-top"
                             alt="Keman">

                        <div class="card-body text-center">

                            <h5 class="card-title">
                                Keman
                            </h5>

                            <p class="card-text price-text fw-bold">
                                350 ₺ / Günlük
                            </p>

                            <a asp-controller="Items"
                               asp-action="Details"
                               asp-route-id="1"
                               class="btn btn-outline-primary btn-sm w-100">

                                Detayları Gör

                            </a>

                        </div>

                    </div>

                </div>

                <!-- CIM BICME -->

                <div class="col-md-4 mb-4">

                    <div class="card shadow-sm h-100">

                        <img src="https://tse2.mm.bing.net/th/id/OIP._s6McSK8Dwd_samx3TTg3AHaHa?r=0&rs=1&pid=ImgDetMain&o=7&rm=3"
                             class="card-img-top"
                             alt="Çim Biçme">

                        <div class="card-body text-center">

                            <h5 class="card-title">
                                Çim Biçme Makinesi
                            </h5>

                            <p class="card-text price-text fw-bold">
                                700 ₺ / Günlük
                            </p>

                            <a asp-controller="Items"
                               asp-action="Details"
                               asp-route-id="2"
                               class="btn btn-outline-primary btn-sm w-100">

                                Detayları Gör

                            </a>

                        </div>

                    </div>

                </div>

                <!-- MATKAP -->

                <div class="col-md-4 mb-4">

                    <div class="card shadow-sm h-100">

                        <img src="https://tse2.mm.bing.net/th/id/OIP.PIItuXnJ2SMWMrgUCAU7cwHaHa?r=0&rs=1&pid=ImgDetMain&o=7&rm=3"
                             class="card-img-top"
                             alt="Matkap">

                        <div class="card-body text-center">

                            <h5 class="card-title">
                                Matkap
                            </h5>

                            <p class="card-text price-text fw-bold">
                                250 ₺ / Günlük
                            </p>

                            <a asp-controller="Items"
                               asp-action="Details"
                               asp-route-id="3"
                               class="btn btn-outline-primary btn-sm w-100">

                                Detayları Gör

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>