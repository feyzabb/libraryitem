<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KiralaBunu</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Library_Item.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div id="server-auth-state" data-authenticated="@User.Identity.IsAuthenticated.ToString().ToLower()" style="display: none;"></div>
    <div id="page-wrapper" class="page-fade-wrapper">
        <header>
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-3">
                <div class="container px-md-4 d-flex align-items-center justify-content-between">
                    <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index" style="color: var(--primary-dark) !important;">
                        <div class="logo-container">
                            <img src="/images/logo.png" class="logo-img" alt="KiralaBunu" />
                        </div>
                        <span class="fs-4 fw-extrabold" style="color: var(--primary-dark); font-weight: 800;">KiralaBunu</span>
                    </a>

                    <div class="d-flex align-items-center gap-3">
                        <!-- Basket Icon -->
                        <a class="nav-link p-2 d-flex align-items-center position-relative" href="/Account/Basket" style="transition: var(--transition-smooth); border-radius: 50%;">
                            <i class="bi bi-basket3 fs-4" style="color: var(--slate);"></i>
                        </a>

                        <!-- "+ Kirala" Button -->
                        <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center gap-1" style="background-color: var(--primary) !important; border-color: var(--primary) !important; color: white !important;" data-bs-toggle="modal" data-bs-target="#mülkEkleModal">
                            <i class="bi bi-plus-lg"></i> Kirala
                        </button>

                        <!-- Dynamic Auth Actions -->
                        <div id="auth-actions-layout" class="d-flex align-items-center">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <div class="dropdown" id="user-menu-dropdown-layout">
                                    <button class="btn btn-link dropdown-toggle text-dark fw-bold d-flex align-items-center gap-2 text-decoration-none py-1 px-3" 
                                            type="button" id="dropdownUserMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-circle fs-4" style="color: var(--primary);"></i>
                                        <span class="d-none d-md-inline">Hesabım</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-2" aria-labelledby="dropdownUserMenu" 
                                        style="border-radius: var(--border-radius-md); min-width: 170px;">
                                        <li>
                                            <a class="dropdown-item fw-bold py-2" href="/Account/MyItems">
                                                <i class="bi bi-collection-fill me-2" style="color: var(--primary);"></i> İlanlarım
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item fw-bold py-2" href="/Account/Basket">
                                                <i class="bi bi-basket-fill me-2" style="color: var(--primary);"></i> Sepetim
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button class="dropdown-item fw-bold py-2 text-danger" id="btn-logout-sim">
                                                <i class="bi bi-box-arrow-right me-2"></i> Çıkış Yap
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-secondary rounded-pill px-3 fw-bold btn-sm btn-login" data-bs-toggle="modal" data-bs-target="#loginModal" id="btn-login-layout">
                                    <i class="bi bi-person-circle me-1"></i> Giriş Yap
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-center">
            &copy; 2026 - KiralaBunu - <a asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
        </div>
    </footer>
    </div> <!-- #page-wrapper ends here to prevent stacking context clashes -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <div class="modal fade" id="registerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 450px;">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body p-4 pt-0">
                    <h2 class="fw-bold mb-3 text-center">Üye Ol</h2>
                    <p class="text-muted small mb-4 text-center">KiralaBunu'ya katıl ve paylaşmaya başla!</p>

                    @await Html.PartialAsync("~/Views/Account/Register.cshtml")
                </div>
            </div>
        </div>
    </div>

    <!-- Global "Kirala" listing creation modal -->
    <div class="modal fade" id="mülkEkleModal" tabindex="-1" aria-labelledby="mülkEkleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 24px;">

                <div class="modal-header border-0 pb-0 justify-content-between align-items-center">
                    <div class="w-100 text-center ps-4">
                        <h4 class="modal-title fw-bold text-dark pt-3" id="mülkEkleModalLabel">Eşyanı Kiraya Ver</h4>
                        <p class="text-muted small mb-0">Paylaşarak kazanmaya hemen başla.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body px-4 pt-4 pb-4">
                    <form asp-controller="Items" asp-action="Create" method="post" enctype="multipart/form-data">

                        <div class="form-group mb-3 text-start">
                            <label class="fw-bold small mb-1 text-muted">Eşya / İlan Başlığı</label>
                            <input type="text" name="Title" class="form-control rounded-3 bg-light border-0 py-2 px-3" placeholder="Örn: Profesyonel Keman, Şarjlı Süpürge" required />
                        </div>

                        <div class="form-group mb-3 text-start">
                            <label class="fw-bold small mb-1 text-muted">Kategori</label>
                            <select name="Category" class="form-select rounded-3 bg-light border-0 py-2 px-3" required>
                                <option value="Sanat">Sanat</option>
                                <option value="Elektronik">Elektronik</option>
                                <option value="Ev">Ev Eşyası</option>
                                <option value="Bahce">Bahçe</option>
                            </select>
                        </div>

                        <div class="form-group mb-3 text-start">
                            <label class="fw-bold small mb-1 text-muted">Günlük Kiralama Bedeli (₺)</label>
                            <div class="input-group">
                                <input type="number" name="Price" class="form-control rounded-start-3 bg-light border-0 py-2 px-3" placeholder="150" min="1" required />
                                <span class="input-group-text bg-secondary-subtle border-0 fw-bold">₺ / Gün</span>
                            </div>
                        </div>

                        <div class="form-group mb-3 text-start">
                            <label class="fw-bold small mb-1 text-muted">Ürün Görseli</label>
                            <input type="file" name="ImageFile" class="form-control rounded-3 bg-light border-0 py-2 px-3" accept="image/*" />
                        </div>

                        <div class="form-group mb-4 text-start">
                            <label class="fw-bold small mb-1 text-muted">Eşyanın Durumu ve Açıklaması</label>
                            <textarea name="Description" class="form-control rounded-3 bg-light border-0 py-2 px-3" rows="3" placeholder="Eşyanızın durumu, yanında verilecek aparatlar vb..." required></textarea>
                        </div>

                        <button type="submit" class="btn text-white w-100 rounded-pill py-2.5 fw-bold shadow-sm" style="background-color: var(--primary); border-color: var(--primary);">
                            <i class="bi bi-check-circle-fill me-1"></i> İlanı Yayınla
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>

    <!-- Global "Giriş Yap" modal outside page wrapper -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 380px;">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-header border-0 pb-0 justify-content-between align-items-center">
                    <div class="w-100 text-center ps-4">
                        <h4 class="modal-title fw-bold text-dark pt-3" id="loginModalLabel">Giriş Yap</h4>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 pt-4">
                    <form asp-controller="Account" asp-action="Login" method="post">
                        <div class="form-group mb-3 text-start">
                            <label class="fw-bold small mb-1 text-muted">E-posta Adresi</label>
                            <input type="email" name="Email" class="form-control rounded-pill bg-light border-0 py-2 px-3" placeholder="E-postanızı girin" required />
                        </div>
                        <div class="form-group mb-4 text-start">
                            <label class="fw-bold small mb-1 text-muted">Şifre</label>
                            <input type="password" name="Password" class="form-control rounded-pill bg-light border-0 py-2 px-3" placeholder="Şifrenizi girin" required />
                        </div>
                        <button type="submit" class="btn w-100 rounded-pill py-2 fw-bold text-white btn-login-submit" style="background-color: var(--primary); border-color: var(--primary);">
                            Giriş Yap
                        </button>
                    </form>
                    <div class="register-link mt-4 mb-3 text-center small">
                        <p class="text-muted mb-0">
                            Üye değilseniz
                            <a href="Account/Register" class="text-danger fw-bold text-decoration-none ms-1">Üye Ol</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
